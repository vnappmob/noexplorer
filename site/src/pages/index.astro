---
// Home page: one message (local ↔ remote transfers), the app mockup, download, a few points and a
// short feature grid. Detail lives in the docs (Starlight, /docs/). Keep it short (AGENTS.md).
const site = "https://noexplorer.vnappmob.com/";
const ld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "NoExplorer",
  description:
    "A two-pane file manager: your computer on the left, your cloud storage on the right. Drag to upload or download. For S3, Nextcloud, WebDAV and Box.",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "macOS, Windows, Linux",
  url: site,
  downloadUrl: "https://github.com/vnappmob/noexplorer/releases/latest",
  license: "https://opensource.org/licenses/MIT",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Organization", name: "VNAppMob", url: "https://github.com/vnappmob" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NoExplorer: drag files between your computer and your cloud</title>
    <meta
      name="description"
      content="Your computer on the left, your cloud on the right. Drag to upload or download. Free and open source for macOS, Windows and Linux, for S3, Nextcloud, WebDAV and Box."
    />
    <link rel="canonical" href={site} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:site_name" content="NoExplorer" />
    <meta property="og:title" content="NoExplorer" />
    <meta
      property="og:description"
      content="Your computer on the left, your cloud on the right. Drag to upload or download."
    />
    <meta property="og:image" content="https://noexplorer.vnappmob.com/icon.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="NoExplorer" />
    <meta name="twitter:description" content="Your computer on the left, your cloud on the right. Drag to upload or download." />
    <meta name="keywords" content="S3 client, S3 file manager, MinIO client, Nextcloud client, WebDAV client, Box, dual-pane file manager, backup, macOS, Windows, Linux, open source" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <meta name="theme-color" content="#0b0d12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.png" />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/style.css" />
    <script is:inline src="/app.js" defer></script>
  </head>
  <body>
    <header class="nav">
      <a class="brand" href="/"><img src="/icon.svg" alt="" width="28" height="28" />NoExplorer</a>
      <nav>
        <a href="/docs/">Docs</a>
        <a href="https://github.com/vnappmob/noexplorer" class="gh">GitHub</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <a class="badge" id="ver-badge" href="https://github.com/vnappmob/noexplorer/blob/main/CHANGELOG.md">
          <b>What's new</b>
        </a>
        <h1>Your computer on the left.<br /><span>Your cloud on the right.</span></h1>
        <p class="lead">Drag between them to upload or download. That's it.</p>
        <div class="cta">
          <a id="dl-main" class="btn primary" href="https://github.com/vnappmob/noexplorer/releases/latest">
            <span id="dl-label">Download</span>
            <small id="dl-meta">for macOS, Windows &amp; Linux</small>
          </a>
          <a class="btn" href="/docs/">Read the docs</a>
        </div>
        <p class="other" id="dl-other"></p>
        <p class="trust">Free &amp; open source · S3 · Nextcloud · WebDAV · Box</p>

        <!-- The app, drawn in HTML so it stays crisp and follows the page's light/dark theme. -->
        <div class="app" aria-hidden="true">
          <div class="app-top">
            <span class="lights"><i></i><i></i><i></i></span>
            <span class="omni">⌕ Search files, buckets, commands… <kbd>⌘K</kbd></span>
          </div>
          <div class="app-panes">
            <div class="mpane">
              <div class="mhead">
                <span class="chip"><i class="ci">⌂</i>This computer <em>Home</em></span>
              </div>
              <div class="mpath">↑ · Users › kris › <b>Projects</b><span class="sum">Σ 18.4 GB</span></div>
              <div class="mcols"><span>Name</span><span>Size</span></div>
              <div class="mrow">
                <span><i class="fi d"></i>photos-2026</span><em>12.1 GB</em>
              </div>
              <div class="mrow sel">
                <span><i class="fi d"></i>website</span><em>2.3 GB</em>
              </div>
              <div class="mrow">
                <span><i class="fi d"></i>invoices</span><em>840 MB</em>
              </div>
              <div class="mrow">
                <span><i class="fi"></i>dump.sql</span><em class="plain">48 MB</em>
              </div>
              <div class="mrow">
                <span><i class="fi"></i>cover.png</span><em class="plain">820 KB</em>
              </div>
              <div class="disk">
                <div class="dhead"><b>Macintosh HD</b><span>129 GB available of 460 GB</span></div>
                <div class="dbar"><i class="here"></i><i class="other"></i></div>
                <div class="dleg">
                  <span><i class="dot here"></i>Projects 18.4 GB</span
                  ><span><i class="dot other"></i>Other 313 GB</span>
                </div>
              </div>
            </div>
            <div class="mpane">
              <div class="mhead">
                <span class="chip"><i class="ci cloud">☁</i>Home NAS <em>Nextcloud</em></span>
              </div>
              <div class="mpath">↑ · nextcloud:// Files › <b>Backups</b></div>
              <div class="mcols"><span>Name</span><span>Size</span></div>
              <div class="mrow">
                <span><i class="fi d"></i>2026-09</span><em class="plain"></em>
              </div>
              <div class="mrow target">
                <span><i class="fi d"></i>2026-10</span><em class="plain"></em>
              </div>
              <div class="mrow">
                <span><i class="fi"></i>site.tar.gz</span><em class="plain">312 MB</em>
              </div>
              <div class="mrow">
                <span><i class="fi"></i>notes.md</span><em class="plain">4 KB</em>
              </div>
              <div class="activity">
                <b>↑ website</b><small>→ Backups/2026-10/</small>
                <div class="abar"><i></i></div>
                <small>1,284 of 3,105 files · 94 MB/s</small>
              </div>
            </div>
            <svg class="beam" viewBox="0 0 100 40" preserveAspectRatio="none">
              <path d="M30 24 C 44 4, 60 4, 72 20" />
            </svg>
          </div>
        </div>
      </section>

      <section class="points">
        <div>
          <h3>Drag either way</h3>
          <p>Left to right uploads, right to left downloads. Folders keep their structure.</p>
        </div>
        <div>
          <h3>Big files, no fuss</h3>
          <p>Parallel transfers with live progress. They keep going when you close the window.</p>
        </div>
        <div>
          <h3>Nothing gets lost</h3>
          <p>Downloads never overwrite your files, and Compare shows that everything arrived.</p>
        </div>
      </section>

      <section class="more" aria-labelledby="more-title">
        <h2 id="more-title">And the rest of what you'd expect</h2>
        <ul class="features">
          <li>
            <a href="/docs/tools/#compare-folders"><b>Compare &amp; verify</b><span>See what's missing after a backup, checked by checksum.</span></a>
          </li>
          <li>
            <a href="/docs/transfers/#several-accounts-at-once"><b>Cloud to cloud</b><span>Up to three accounts side by side; drag between them to copy.</span></a>
          </li>
          <li>
            <a href="/docs/tools/#folder-sizes"><b>Folder sizes</b><span>Every folder's size as you browse, faster than ncdu.</span></a>
          </li>
          <li>
            <a href="/docs/tools/#quick-look"><b>Quick look</b><span>Images, video, PDF and text, without downloading.</span></a>
          </li>
          <li>
            <a href="/docs/accounts/"><b>Your storage</b><span>S3, R2, B2, Wasabi, MinIO, Nextcloud, WebDAV, Box.</span></a>
          </li>
          <li>
            <a href="/docs/privacy/"><b>Private by design</b><span>Keys in your keychain, no accounts, no tracking.</span></a>
          </li>
        </ul>
        <p class="more-link"><a href="/docs/">Read the docs →</a></p>
      </section>
    </main>

    <footer>
      <p>
        <a href="/docs/">Docs</a> · <a href="https://github.com/vnappmob/noexplorer">GitHub</a> ·
        <a href="https://github.com/vnappmob/noexplorer/releases">Releases</a> ·
        <a href="https://github.com/vnappmob/noexplorer/blob/main/CHANGELOG.md">Changelog</a> ·
        <a href="/docs/privacy/">Privacy</a> ·
        <a href="/docs/code-signing/">Code signing</a>
      </p>
      <p class="muted">MIT License · Made by Kris Luu at <a href="https://github.com/vnappmob">VNAppMob</a></p>
    </footer>
  </body>
</html>
