<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installers" (ADR-030). Paste into the SignPath project.
     release.yml uploads the installers under these fixed names and renames them afterwards. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="noexplorer-setup.exe" product-name="NoExplorer">
      <authenticode-sign />
    </pe-file>
    <msi-file path="noexplorer.msi" product-name="NoExplorer">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
