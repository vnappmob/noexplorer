<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app-exe" (ADR-030). Paste into the SignPath project.
     Signs the app binary before the installers are built around it (release.yml → windows). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="noexplorer.exe" product-name="NoExplorer">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
