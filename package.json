{
  "name": "noexplorer",
  "private": true,
  "version": "0.4.22",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit && prettier --check src",
    "fmt": "prettier --write src && cd src-tauri && cargo fmt",
    "tauri": "tauri",
    "clean:build": "bash scripts/clean-build.sh",
    "site": "wrangler dev",
    "site:build": "npm ci --prefix site && npm run build --prefix site",
    "site:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "wrangler": "^4.151.0"
  },
  "description": "Dual-pane drag & drop file manager for S3-compatible storage (MinIO, SeaweedFS, AWS S3…)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vnappmob/noexplorer.git"
  }
}
